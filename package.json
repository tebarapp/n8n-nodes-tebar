{
	"name": "n8n-nodes-tebar",
	"version": "0.1.1",
	"description": "n8n nodes for Tebar: publish and schedule social media posts, manage comments, and react to Tebar events",
	"license": "MIT",
	"homepage": "https://tebar.app",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"tebar",
		"social media",
		"threads",
		"instagram",
		"tiktok",
		"scheduling"
	],
	"author": {
		"name": "PT Kirim Chat Indonesia",
		"email": "halo@tebar.app",
		"url": "https://tebar.app"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tebarapp/n8n-nodes-tebar.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TebarApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Tebar/Tebar.node.js",
			"dist/nodes/TebarTrigger/TebarTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.10.1",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
